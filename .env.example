# Z-Gym Helper Environment Variables Example
# Duplicate this file as .env.local and fill in your credentials.

# 1. Base App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Database (MongoDB Atlas) - The application strictly reads MONGODB_URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/zgymhelper?retryWrites=true&w=majority

# 3. Authentication (Auth.js / NextAuth v5)
AUTH_SECRET=development_secret_key_at_least_32_characters_long
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=your_google_oauth_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

# 4. Administrator Access
ADMIN_EMAILS=admin@zgym.test,trainer@zgym.test

# 5. Scheduled Reminders Cron Security
CRON_SECRET=super_secret_cron_token_for_scheduling_push

# 6. Push Notifications - Server (Firebase Admin SDK)
# Base64-encoded string of your serviceAccountKey.json (decoded server-side only in memory)
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_firebase_service_account_json

# 7. Push Notifications - Client (Firebase Web SDK / VAPID)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_web_push_vapid_key

# 8. Advertising (Google AdSense)
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_PUBLISHER_ID=pub-XXXXXXXXXXXXXXXX

# 9. Feature Flags
NEXT_PUBLIC_SHOW_PRODUCTS=false
